# Supabase — projeto do escritório
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Postgres — DATABASE_URL usa o pooler (pgbouncer, porta 6543) para a aplicação;
# DIRECT_URL usa a conexão direta (porta 5432) só para migrações (drizzle-kit).
DATABASE_URL=
DIRECT_URL=

# IA (Google Gemini) — chamada só no servidor, nunca prefixar com NEXT_PUBLIC_.
# Chave gratuita em https://aistudio.google.com/apikey
GEMINI_API_KEY=
